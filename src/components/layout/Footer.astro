---
import { Image } from "astro:assets";
import { business, footerServiceLinks, footerSitemapLinks, secondaryNavLinks } from "@data/site";
import { isRealProfileUrl } from "@lib/seo";
import footerLogo from "@assets/logos/jim-dandy-logo-plain.webp";

const year = new Date().getFullYear();
---

<footer class="bg-navy-800 pt-16 text-white">
  <div class="container-page">
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 pb-24 sm:grid-cols-2 lg:pb-12 sm:gap-12 lg:grid-cols-4">
      <div class="col-span-2 flex flex-col gap-6 lg:col-span-1">
        <a href="/" aria-label="Jim Dandy Sewer & Plumbing, Home">
          <Image src={footerLogo} alt="Jim Dandy Sewer & Plumbing" class="h-auto max-h-14 w-auto max-w-full object-contain" />
        </a>
        <div class="flex flex-col gap-4">
          <span class="font-display text-sm font-bold uppercase tracking-[0.2em] text-white/60">
            License No.
          </span>
          <div class="flex items-center gap-3">
            {business.licenses.map((license, i) => (
              <>
                {i > 0 && <span class="h-6 w-px shrink-0 bg-white/20" aria-hidden="true"></span>}
                <span class="whitespace-nowrap rounded-full border border-white/30 px-4 py-2 font-mono text-xs font-semibold tracking-wide text-white/90">
                  {license}
                </span>
              </>
            ))}
          </div>
        </div>
      </div>

      <div>
        <h2 class="font-heading text-lg font-semibold text-white">Services</h2>
        <ul class="mt-4 flex flex-col">
          {footerServiceLinks.map((link) => (
            <li>
              <a href={link.href} class="inline-flex min-h-11 items-center text-base text-white/80 transition-colors hover:text-white">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="font-heading text-lg font-semibold text-white">Sitemap</h2>
        <ul class="mt-4 flex flex-col">
          {[...footerSitemapLinks, ...secondaryNavLinks].map((link) => (
            <li>
              <a href={link.href} class="inline-flex min-h-11 items-center text-base text-white/80 transition-colors hover:text-white">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="col-span-2 sm:col-span-1">
        <h2 class="font-heading text-lg font-semibold text-white">Contact</h2>
        <ul class="mt-4 flex flex-col gap-1 text-base text-white/80">
          <li>
            <a href={business.phoneHref} class="inline-flex min-h-11 items-center font-display text-2xl font-bold text-white">
              {business.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${business.email}`} class="inline-flex min-h-11 items-center break-all hover:text-white">
              {business.email}
            </a>
          </li>
          <li>
            {business.address.full}
          </li>
          <li>
            {business.hours}
          </li>
        </ul>
        <div class="mt-5 flex flex-wrap gap-3">
          {/* Each icon stays hidden unless site.ts holds a real profile URL - a
              bare domain root ("https://www.facebook.com/") would send every
              visitor to Facebook's homepage. */}
          {isRealProfileUrl(business.social.facebook) && (
            <a
              href={business.social.facebook}
              aria-label="Jim Dandy on Facebook"
              class="grid h-11 w-11 place-items-center rounded-full bg-white/10 transition-colors hover:bg-brand-green-500 hover:text-navy-900"
            >
              <svg viewBox="0 0 24 24" class="h-8 w-8" fill="currentColor" aria-hidden="true">
                <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06C2 17.08 5.66 21.23 10.44 22v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22C18.34 21.23 22 17.08 22 12.06z" />
              </svg>
            </a>
          )}
          {isRealProfileUrl(business.social.instagram) && (
            <a
              href={business.social.instagram}
              aria-label="Jim Dandy on Instagram"
              class="grid h-11 w-11 place-items-center rounded-full bg-white/10 transition-colors hover:bg-brand-green-500 hover:text-navy-900"
            >
              <svg viewBox="0 0 24 24" class="h-7 w-7" fill="currentColor" aria-hidden="true">
                <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07zM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.71-2.13 1.38C1.34 2.68.93 3.35.63 4.14.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.71 1.46 1.38 2.13.67.67 1.34 1.08 2.13 1.38.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56.79-.3 1.46-.71 2.13-1.38.67-.67 1.08-1.34 1.38-2.13.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91-.3-.79-.71-1.46-1.38-2.13C21.32 1.34 20.65.93 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm7.85-10.4a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0z" />
              </svg>
            </a>
          )}
          {isRealProfileUrl(business.social.yelp) && (
            <a
              href={business.social.yelp}
              aria-label="Jim Dandy on Yelp"
              class="grid h-11 w-11 place-items-center rounded-full bg-white/10 transition-colors hover:bg-brand-green-500 hover:text-navy-900"
            >
              <svg viewBox="0 0 24 24" class="h-7 w-7" fill="currentColor" aria-hidden="true">
                <path d="M10.6 16.2l-3.3 3.6c-.4.4-1 .3-1.3-.1a7.3 7.3 0 0 1-1.1-2.7c-.1-.6.3-1 .9-1l4.7-.7c.7-.1 1.2.5 1 1zm-1.9-3.1l-4.3-2c-.5-.3-.7-.9-.4-1.4.5-.9 1.2-1.7 2-2.3.5-.4 1.1-.1 1.3.4l1.9 4.4c.3.6-.1 1.2-.5.9zm3.1-1.6c-.5-.2-.7-.6-.7-1.1L11 2.2c0-.6.4-1.1 1-1.1 1.6.1 3.2.5 4.6 1.3.5.3.7.9.4 1.4l-4.2 7c-.3.5-.7.9-1 .7zm.9 3.3c.3-.5.9-.6 1.3-.3l3.7 3c.4.4.5 1 .1 1.4a8.9 8.9 0 0 1-2.9 2.1c-.6.2-1.2-.1-1.3-.7l-1-4.7c-.1-.3 0-.6.1-.8zm1.5-2.6c-.6.1-1.1-.4-1-1l.5-4.7c.1-.6.6-1 1.2-.8 1.1.3 2.1.9 2.9 1.7.4.4.4 1.1-.1 1.4l-3.5 3.4z" />
              </svg>
            </a>
          )}
          <a
            href={business.social.google}
            aria-label="Jim Dandy on Google"
            class="grid h-11 w-11 place-items-center rounded-full bg-white/10 text-3xl font-bold transition-colors hover:bg-brand-green-500 hover:text-navy-900"
          >
            G
          </a>
        </div>
      </div>
    </div>

  </div>
  {/* The mobile sticky CTA is fixed over the bottom of the viewport, so at the
      end of the page it sat on top of this strip and the launchers landed on
      the social icons. StickyCta publishes its height here and the strip grows
      to match, keeping its own background under the reserved space. */}
  <div id="footer-legal" class="bg-brand-green-500 pb-[var(--sticky-cta-reserve,0px)] lg:pb-0">
    {/* Stays stacked and centred until lg: from sm to md this row was laid out
         edge-to-edge and "Terms of Service" ran under the chat launcher in the
         bottom-right corner. Centred, it clears both launchers. */}
    <div class="container-page flex flex-col items-center justify-between gap-2 py-2 text-sm font-semibold text-navy-900 lg:flex-row">
      <p>Copyrighted © {year} {business.name} | All Rights Reserved</p>
      <div class="flex items-center gap-4">
        <a href="/privacy-policy" class="-my-3 inline-flex min-h-11 items-center py-3 underline hover:text-navy-700">Privacy Policy</a>
        <a href="/terms" class="-my-3 inline-flex min-h-11 items-center py-3 underline hover:text-navy-700">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>

<script>
  // The chat and accessibility launchers are fixed in the bottom corners, so on
  // arrival at the end of the page they sat on the copyright line and the
  // Privacy/Terms links. While this strip is on screen, publish its height and
  // the launchers lift clear of it (they take max(this, the sticky CTA lift)).
  function initFooterLift() {
    const strip = document.getElementById("footer-legal");
    if (!strip || !("IntersectionObserver" in window)) return;
    const root = document.documentElement;
    let visible = false;
    const apply = () => root.style.setProperty("--footer-lift", visible ? `${Math.round(strip.getBoundingClientRect().height)}px` : "0px");
    new IntersectionObserver((entries) => {
      visible = entries.some((entry) => entry.isIntersecting);
      apply();
    }).observe(strip);
    window.addEventListener("resize", apply, { passive: true });
  }
  if (document.readyState !== "loading") initFooterLift();
  else document.addEventListener("DOMContentLoaded", initFooterLift);
</script>
