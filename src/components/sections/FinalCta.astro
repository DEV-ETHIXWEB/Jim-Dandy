---
import { Image } from "astro:assets";
import SectionHeading from "@components/ui/SectionHeading.astro";
import Button from "@components/ui/Button.astro";
import YearsBadge from "@components/ui/YearsBadge.astro";
import finalCtaPhoto from "@assets/photos/team-crew-gradient.webp";
import { business } from "@data/site";
---

<section class="relative overflow-hidden bg-white pt-8 pb-20 lg:pt-10 lg:pb-28">
  {/* The tint is still ~30% opaque where it meets the white section above, so
      inset-0 sliced it into a visible band. Feathering the overlay's own edges
      lets it fade out before the boundary instead of being cut. Anchored right
      so the glow sits behind the team photo instead of fighting the green CTA. */}
  <div
    class="pointer-events-none absolute inset-0"
    style="background: radial-gradient(120% 100% at 88% 45%,
      rgba(220,255,194,0.95) 0%,
      rgba(220,255,194,0.7) 30%,
      rgba(220,255,194,0.35) 50%,
      rgba(220,255,194,0.1) 68%,
      rgba(220,255,194,0) 82%);
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 22%, #000 88%, transparent 100%);
      mask-image: linear-gradient(to bottom, transparent 0%, #000 22%, #000 88%, transparent 100%);"
    aria-hidden="true"
  ></div>

  <div class="container-page relative flex flex-col gap-12">
    <SectionHeading
      title="Ready to Fix Your Plumbing Problem?"
      subtitle={`Jim Dandy has served Seattle since ${business.founded}. We're available 24/7 - call or schedule online.`}
    />

    {/* One photo for every breakpoint, kept inside the page width. It used to
        bleed off the right edge on desktop (and to 125% on phones), which cut
        off the crew member on the far right. The 118-years badge sits in the
        frame's empty top-left corner, where it covers nobody. */}
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[18rem_1fr] lg:gap-14">
      <div class="relative grid grid-cols-2 gap-3 sm:flex sm:flex-row sm:justify-center sm:gap-4 lg:flex-col">
        <div
          class="pointer-events-none absolute -inset-10 -z-10 rounded-full opacity-80 blur-3xl"
          style="background: radial-gradient(circle, rgba(105,190,40,0.16), rgba(105,190,40,0) 70%);"
          aria-hidden="true"
        ></div>
        <Button href={business.scheduleUrl} variant="primary" fullWidth class="max-sm:px-3">Schedule Online</Button>
        <Button href={business.financingUrl} variant="secondary" fullWidth class="max-sm:px-3">Get Financed</Button>
      </div>

      <div class="group relative mx-auto w-full max-w-[1000px]">
        <Image
          src={finalCtaPhoto}
          alt="The full Jim Dandy Sewer & Plumbing crew standing together in front of a service truck"
          widths={[640, 960, 1280, 1600, 2000, 2600]}
          sizes="(min-width: 1280px) 900px, (min-width: 1024px) 68vw, calc(100vw - 2.5rem)"
          quality={86}
          loading="lazy"
          class="h-auto w-full transition-transform duration-500 ease-out group-hover:-translate-y-1.5"
        />
        <div class="pointer-events-none absolute left-0 top-0 z-20 -translate-x-[8%] -translate-y-[22%]">
          <YearsBadge
            years={business.yearsInBusiness}
            year={business.founded}
            class="h-[clamp(72px,13vw,132px)] w-[clamp(72px,13vw,132px)]"
          />
        </div>
      </div>
    </div>
  </div>
</section>
