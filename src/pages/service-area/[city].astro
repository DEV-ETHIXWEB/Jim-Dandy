---
/**
 * City landing pages at the URLs the previous site ranked on
 * (/service-area/shoreline, /service-area/mountlake-terrace). These used to be
 * 301s into /service-area; the redirects were removed from astro.config.mjs
 * when these pages came back, so do not re-add them.
 */
import Layout from "@layouts/Layout.astro";
import Button from "@components/ui/Button.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
import PageHero from "@components/sections/PageHero.astro";
import Accordion from "@components/sections/Accordion";
import FinalCta from "@components/sections/FinalCta.astro";
import MotionInit from "@components/ui/MotionInit.astro";
import StickyCta from "@components/ui/StickyCta.astro";
import { business, serviceAreaCities } from "@data/site";
import { cityPages } from "@data/cityPages";
import { breadcrumbSchema, faqSchema } from "@lib/seo";
import { Check, MapPin, Phone } from "lucide-react";

export function getStaticPaths() {
  return cityPages.map((page) => ({ params: { city: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const path = `/service-area/${page.slug}`;

const crumbs = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Service Area", path: "/service-area" },
  { name: page.city, path },
]);

// Nearby cities give the page internal links and show the reader we cover more
// than the one city they searched for.
const nearby = serviceAreaCities.filter((c) => c !== page.city).slice(0, 12);
---

<Layout title={page.seoTitle} description={page.seoDescription} path={path}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema(page.faqs))} slot="head" />

  <PageHero
    leadForm
    eyebrow={`Serving ${page.city}, WA`}
    title={page.h1}
    lead={page.lead}
    crumbs={[{ name: "Home", href: "/" }, { name: "Service Area", href: "/service-area" }, { name: page.city }]}
  />

  <!-- Opening copy -->
  <section class="bg-white pt-20 lg:pt-28">
    <div class="container-page flex max-w-3xl flex-col gap-5" data-reveal>
      {page.intro.map((para) => (
        <p class="text-lg leading-relaxed text-navy-700">{para}</p>
      ))}
    </div>
  </section>

  <!-- Services in this city -->
  <section class="bg-white py-20 lg:py-28">
    <div class="container-page flex flex-col gap-12">
      {page.sections.map((section) => (
        <div class="flex flex-col gap-5 rounded-[28px] border border-navy-200 bg-surface p-8 lg:p-10" data-reveal>
          <h2 class="font-display text-[26px] font-bold leading-tight text-navy-800 sm:text-3xl">{section.title}</h2>
          {section.body?.map((para) => (
            <p class="max-w-3xl text-base leading-relaxed text-navy-700 sm:text-lg">{para}</p>
          ))}
          {section.bullets && (
            <ul class="grid grid-cols-1 gap-x-10 gap-y-4 lg:grid-cols-2">
              {section.bullets.map((bullet) => (
                <li class="flex items-start gap-3">
                  <span class="mt-1 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-brand-green-500/15 text-brand-green-700">
                    <Check className="h-4 w-4" strokeWidth={2.5} aria-hidden="true" />
                  </span>
                  <p class="text-base leading-relaxed text-navy-700">
                    <strong class="font-semibold text-navy-900">{bullet.label}:</strong> {bullet.text}
                  </p>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- Why this city trusts us -->
  <section class="relative overflow-hidden bg-navy-900 py-20 lg:py-28">
    <div
      class="pointer-events-none absolute inset-0 opacity-40"
      style="background: radial-gradient(700px circle at 20% 20%, rgba(105,190,40,0.16), transparent 60%);"
      aria-hidden="true"
    >
    </div>
    <div class="container-page relative flex flex-col gap-12">
      <div data-reveal>
        <SectionHeading eyebrow="Local Authority" title={page.why.title} subtitle={page.why.intro} light />
      </div>
      <ul class="grid grid-cols-1 gap-6 lg:grid-cols-2" data-reveal-group>
        {page.why.points.map((point) => (
          <li class="flex flex-col gap-2 rounded-[28px] border border-white/10 bg-white/5 p-7 backdrop-blur-sm">
            <p class="font-display text-lg font-bold text-white">{point.label}</p>
            <p class="text-base leading-relaxed text-white/75">{point.text}</p>
          </li>
        ))}
      </ul>

      <a
        href={business.phoneHref}
        class="group mx-auto flex w-full max-w-md items-center gap-4 rounded-2xl border border-brand-green-500/40 bg-brand-green-500/10 p-5 transition-colors hover:bg-brand-green-500/20"
        data-reveal
      >
        <span class="grid h-14 w-14 shrink-0 place-items-center rounded-full bg-[image:var(--btn-primary)] text-navy-900 shadow-[var(--shadow-btn-green)]">
          <Phone className="h-6 w-6" aria-hidden="true" />
        </span>
        <span class="flex flex-col">
          <span class="text-sm font-semibold uppercase tracking-[0.12em] text-brand-green-400">{page.city} - call us 24/7</span>
          <span class="font-display text-[30px] font-bold leading-none text-white">{business.phone}</span>
        </span>
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white py-20 lg:py-28">
    <div class="container-page flex flex-col gap-12">
      <div data-reveal>
        <SectionHeading eyebrow="Good to Know" title={`${page.city} Plumbing Questions, Answered`} />
      </div>
      <div class="mx-auto w-full max-w-3xl" data-reveal>
        <Accordion client:idle items={page.faqs} />
      </div>
    </div>
  </section>

  <!-- Nearby cities -->
  <section class="bg-surface py-16">
    <div class="container-page flex flex-col gap-6" data-reveal>
      <div class="flex items-center gap-3">
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl icon-chip">
          <MapPin className="h-5 w-5" aria-hidden="true" />
        </span>
        <h2 class="font-display text-2xl font-bold text-navy-800">We also serve nearby</h2>
      </div>
      <ul class="flex flex-wrap gap-2.5">
        {nearby.map((cityName) => (
          <li>
            <span class="inline-flex min-h-11 items-center rounded-full border border-navy-200 bg-white px-4 text-base font-semibold text-navy-700">
              {cityName}
            </span>
          </li>
        ))}
      </ul>
      <Button href="/service-area" variant="secondary" size="md" class="self-start">See the full service area</Button>
    </div>
  </section>

  <FinalCta />

  <StickyCta />
  <MotionInit />
</Layout>
